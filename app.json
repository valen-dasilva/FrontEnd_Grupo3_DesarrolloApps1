{
  "expo": {
    "name": "ProyectoTuristear",
    "slug": "ProyectoTuristear",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "scheme": "miapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.Turistear.app"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "La app necesita acceso al calendario para agregar tus actividades.",
          "remindersPermission": "La app necesita acceso a recordatorios."
        }
      ], 
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icono.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "TuristeAR necesita acceso a tus fotos para agregarlas a tus itinerarios.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c30baf96-af84-4130-9cde-16acc168da7e"
      }
    },
    "android": {
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    }
  }
}
